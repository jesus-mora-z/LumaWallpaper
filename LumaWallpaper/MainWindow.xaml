<Window x:Class="LumaWallpaper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Luma Wallpaper"
        Width="940"
        Height="620"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#10131A"
        Closing="Window_Closing">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="LUMA"
                       Foreground="#8B7BFF"
                       FontSize="11"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Tu escritorio, en movimiento."
                       Foreground="#F2F4F8"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Margin="0,5,0,0"/>
            <TextBlock Text="Fondos GIF y MP4, reproducidos con las herramientas de Windows."
                       Foreground="#9AA5B5"
                       FontSize="12"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#191E28"
                    BorderBrush="#28303D"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,20,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="VISTA PREVIA"
                               Foreground="#9AA5B5"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Margin="4,0,0,10"/>
                    <Border Grid.Row="1" Background="#0B0E13" CornerRadius="8">
                        <Grid ClipToBounds="True">
                            <MediaElement x:Name="PreviewVideo"
                                          LoadedBehavior="Manual"
                                          UnloadedBehavior="Stop"
                                          Stretch="UniformToFill"
                                          Volume="0"
                                          Visibility="Collapsed"
                                          MediaOpened="PreviewVideo_MediaOpened"
                                          MediaEnded="PreviewVideo_MediaEnded"
                                          MediaFailed="PreviewVideo_MediaFailed"/>
                            <Image x:Name="PreviewGif"
                                   Stretch="UniformToFill"
                                   Visibility="Collapsed"/>
                            <TextBlock x:Name="PreviewPlaceholder"
                                       Text="Elige un GIF o MP4 para empezar"
                                       Foreground="#778292"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Fondo actual"
                           Foreground="#F2F4F8"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,2,0,10"/>
                <Border Background="#191E28" CornerRadius="8" Padding="13">
                    <TextBlock x:Name="SelectedFileText"
                               Text="Ningún archivo seleccionado"
                               Foreground="#9AA5B5"
                               FontSize="11"
                               TextWrapping="Wrap"/>
                </Border>

                <Button Content="Elegir GIF o MP4"
                        Click="ChooseFile_Click"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,12,0,8"/>
                <Button Content="Aplicar al escritorio"
                        Click="Apply_Click"
                        Style="{StaticResource AccentButton}"/>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            x:Name="PauseButton"
                            Content="Pausar"
                            Click="Pause_Click"
                            Style="{StaticResource SecondaryButton}"/>
                    <Button Grid.Column="2"
                            Content="Quitar fondo"
                            Click="Remove_Click"
                            Style="{StaticResource SecondaryButton}"/>
                </Grid>

                <CheckBox x:Name="AutoStartCheckBox"
                          Content="Iniciar con Windows"
                          Foreground="#F2F4F8"
                          FontSize="11"
                          Margin="0,16,0,0"
                          Checked="AutoStartCheckBox_Changed"
                          Unchecked="AutoStartCheckBox_Changed"/>

                <TextBlock x:Name="StatusText"
                           Text="Listo para empezar"
                           Foreground="#9AA5B5"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,16,0,0"/>

                <TextBlock Text="Consejo: para reducir el consumo, usa videos MP4/H.264 optimizados para la resolución de tu pantalla."
                           Foreground="#748093"
                           FontSize="10"
                           TextWrapping="Wrap"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,2"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
