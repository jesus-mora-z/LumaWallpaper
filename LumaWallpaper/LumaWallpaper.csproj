<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Version>1.1.0</Version>
    <FfmpegPackageVersion>8.0.1.3</FfmpegPackageVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DevEnvy.FFmpeg.Binaries.LGPL" Version="$(FfmpegPackageVersion)" ExcludeAssets="build;buildTransitive;compile;runtime" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(NuGetPackageRoot)devenvy.ffmpeg.binaries.lgpl\$(FfmpegPackageVersion)\ffmpeg\win-x64\**\*">
      <Link>ffmpeg\win-x64\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="ffmpeg-runtime\win-x64\*.dll">
      <Link>ffmpeg\win-x64\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="ffmpeg-runtime\licenses\**\*">
      <Link>ffmpeg\licenses\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(NuGetPackageRoot)devenvy.ffmpeg.binaries.lgpl\$(FfmpegPackageVersion)\THIRD_PARTY_NOTICES.md">
      <Link>ffmpeg\licenses\FFmpeg-THIRD-PARTY-NOTICES.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
