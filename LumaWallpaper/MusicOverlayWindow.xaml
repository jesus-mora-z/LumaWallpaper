<Window x:Class="LumaWallpaper.MusicOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="False"
        Width="360"
        Height="100">
    <Grid Margin="6">
        <Border Background="#E91A1F2A"
                BorderBrush="#743C4555"
                BorderThickness="1"
                CornerRadius="14"
                Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Background="#FF252B36"
                        CornerRadius="8"
                        ClipToBounds="True">
                    <Grid>
                        <Image x:Name="ArtworkImage" Stretch="UniformToFill"/>
                        <TextBlock x:Name="ArtworkPlaceholder"
                                   Text="♪"
                                   Foreground="#AAB3C2"
                                   FontSize="32"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="TrackTitleText"
                               Foreground="#FFF5F7FA"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="38"/>
                    <TextBlock x:Name="TrackArtistText"
                               Foreground="#FFB2BBC9"
                               FontSize="12"
                               Margin="0,5,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
